{
  "name": "vn-dialogs-builder",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vn/desktop dev",
    "build": "pnpm --filter @vn/desktop build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dist:win": "pnpm --filter @vn/desktop dist:win",
    "release": "node scripts/release.mjs",
    "dist:mac": "pnpm --filter @vn/desktop dist:mac"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
